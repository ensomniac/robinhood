# Copying this file is not sufficient. Generate a real key with:
# python3 sensitive_data.py init-key
TRADE_CONTEXT_ACTIVE_KEY=v1
TRADE_CONTEXT_KEY_V1=

# Required private storage for canonical per-symbol, per-day historical market
# observations. Keep this absolute path outside the Git repository. Manifests,
# replay bundles, test results, and compact audits may remain in the repo.
LOCAL_HISTORICAL_DATA_ROOT=/absolute/private/path/to/historical_data

# Optional read-only Interactive Brokers historical-data adapter. The TWS
# socket authenticates through the logged-in desktop app; no API key or account
# number belongs here.
IBKR_HOST=127.0.0.1
IBKR_PORT=7496
IBKR_CLIENT_ID=71
IBKR_CONNECT_TIMEOUT_SECONDS=12
IBKR_REQUEST_TIMEOUT_SECONDS=90
IBKR_MIN_REQUEST_SPACING_SECONDS=0.4
# Safety cap for one shared read-only connection. Historical CLIs separately
# expose --workers; neither setting is permission to bypass IBKR pacing.
IBKR_MAX_CONCURRENT_REQUESTS=4
IBKR_AUTO_START_TWS=false
IBKR_TWS_START_TIMEOUT_SECONDS=45
IBKR_TWS_APP_PATH=
IBKR_EXCHANGE=SMART
IBKR_CURRENCY=USD
IBKR_PRIMARY_EXCHANGE=

# Identification required by SEC.gov for cached point-in-time filing discovery.
# This is public contact metadata, not a secret.
SEC_USER_AGENT=robinhood-codex historical research ryan@ensomniac.com

# Optional read-only SIP provider after IBKR. Never commit the real key.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_TIMEOUT_SECONDS=30
MASSIVE_REFERENCE_MINIMUM_INTERVAL_SECONDS=12.5
# Dashboard-issued S3 credentials are separate from MASSIVE_API_KEY.
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles
MASSIVE_S3_REGION=us-east-1
MASSIVE_S3_TIMEOUT_SECONDS=120

# Optional final read-only fallback after IBKR and Massive. The project aliases
# match the user's existing Alpaca environment. APCA_API_KEY_ID and
# APCA_API_SECRET_KEY are also accepted. ALPACA_ENDPOINT may remain a paper
# trading URL; historical requests always use an official data host below.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_FEED=sip
ALPACA_ADJUSTMENT=raw
ALPACA_TIMEOUT_SECONDS=30
# Pace all REST pages below the common 200-request/minute allowance. Set to 0
# only when the purchased plan explicitly supports the resulting request rate.
ALPACA_MINIMUM_INTERVAL_SECONDS=0.35

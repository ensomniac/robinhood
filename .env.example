# Generate a private key ring with `python3 sensitive_data.py init-key`.
# These legacy variable names are retained for compatibility only; live trading
# is disabled and no account identifier should be persisted by default.
TRADE_CONTEXT_ACTIVE_KEY=v1
TRADE_CONTEXT_KEY_V1=

# Required private canonical market-data store. This must be an absolute path
# outside the public repository.
LOCAL_HISTORICAL_DATA_ROOT=/absolute/private/path/to/historical_data
LOCAL_HISTORICAL_MIN_FREE_GIB=20

# Optional read-only Interactive Brokers historical-data adapter. TWS or IB
# Gateway supplies authentication. This module has no account/order surface.
IBKR_HOST=127.0.0.1
IBKR_PORT=7496
IBKR_CLIENT_ID=71
IBKR_CONNECT_TIMEOUT_SECONDS=12
IBKR_REQUEST_TIMEOUT_SECONDS=90
IBKR_MIN_REQUEST_SPACING_SECONDS=0.4
IBKR_MAX_CONCURRENT_REQUESTS=4
IBKR_AUTO_START_TWS=false
IBKR_TWS_START_TIMEOUT_SECONDS=45
IBKR_TWS_APP_PATH=
IBKR_EXCHANGE=SMART
IBKR_CURRENCY=USD
IBKR_PRIMARY_EXCHANGE=

# Optional read-only Massive historical market-data fallback.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_TIMEOUT_SECONDS=30
MASSIVE_REFERENCE_MINIMUM_INTERVAL_SECONDS=12.5
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles
MASSIVE_S3_REGION=us-east-1
MASSIVE_S3_TIMEOUT_SECONDS=120

# Optional read-only Alpaca historical market-data fallback.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_FEED=sip
ALPACA_ADJUSTMENT=raw
ALPACA_TIMEOUT_SECONDS=30
ALPACA_MINIMUM_INTERVAL_SECONDS=0.35
